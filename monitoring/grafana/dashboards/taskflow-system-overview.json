    {"id": 2, "title": "Jobs submitted/sec", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(taskflow_jobs_submitted_total[5m]))", "refId": "A"}]},
    {"id": 3, "title": "Jobs failed/sec", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(taskflow_jobs_failed_total[5m]))", "refId": "A"}]},
    {"id": 4, "title": "Retry rate", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(taskflow_jobs_retried_total[5m]))", "refId": "A"}]},
